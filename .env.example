# Supabase. Local values come from `pnpm db:start`; hosted projects are in Frankfurt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000   
SUPABASE_SERVICE_ROLE_KEY=        # server + worker only, never exposed to the browser
SUPABASE_URL=                     # worker: same value as NEXT_PUBLIC_SUPABASE_URL

# Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=                  # verifies webhook signatures
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_API_VERSION=v25.0

# AI
ANTHROPIC_API_KEY=

# Later phases
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NANGO_SECRET_KEY=
SENTRY_DSN=

# Direct database connection for tests against staging (Session pooler string, includes the DB password)
SUPABASE_DB_URL=

# Email channel (Postmark). Forwarding addresses live on INBOUND_EMAIL_DOMAIN (MX → inbound.postmarkapp.com).
# Postmark's inbound webhook URL: https://POSTMARK_INBOUND_USER:POSTMARK_INBOUND_PASSWORD@YOUR-APP/api/webhooks/postmark
INBOUND_EMAIL_DOMAIN=
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASSWORD=
POSTMARK_SERVER_TOKEN=
# Relay's own verified sending domain (worker), and Postmark's account token for verifying businesses' domains (app).
EMAIL_SEND_DOMAIN=
POSTMARK_ACCOUNT_TOKEN=

# "Continue with Outlook": Microsoft Entra app (multi-tenant). Needed by both the app (sign-in) and the worker
# (reading and sending mail). APP_URL is the app's public address (worker), for Microsoft's push notifications.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APP_URL=

# "Continue with Google": Google Cloud OAuth client (Web application). Needed by both the app and the worker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
