{
  "name": "workspace-app",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:fast": "node scripts/db-test-fast.mjs",
    "db:test:staging": "node scripts/db-test-remote.mjs",
    "webhook:replay": "node scripts/replay-webhook.mjs",
    "worker": "pnpm --filter @app/worker dev"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.3.16",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^16.6.1",
    "pg": "^8.23.0",
    "supabase": "^2"
  }
}
